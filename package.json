{
  "name": "smiazon-browser",
  "version": "1.0.1",
  "description": "A4: a calm, paper-like web browser with an art home page, ad blocking and a built-in AI assistant",
  "author": "smiazon",
  "homepage": "https://github.com/smiazon/a4",
  "repository": {
    "type": "git",
    "url": "https://github.com/smiazon/a4.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "node scripts/start-electron.js",
    "electron:dev": "concurrently \"npm run dev\" \"sleep 3 && node scripts/start-electron.js\"",
    "electron:build": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@ghostery/adblocker-electron": "^2.20.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.smiazon.a4",
    "productName": "A4",
    "extraMetadata": {
      "productName": "A4"
    },
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "A4-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "A4",
      "iconSize": 88,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 196,
          "type": "file"
        },
        {
          "x": 390,
          "y": 196,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "A4-${version}-windows-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Network",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "A4-${version}-linux-${arch}.${ext}"
    }
  }
}
